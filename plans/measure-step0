# ---- change 6: a second capability on a target the task already opened --
# A task is one consumer session's assignment, so the session is the task.
# Capabilities that share a target inside one task pay the ceremony twice:
# a second begin, a second finalize sequence, its own lookups, and a payload
# that may repeat the first capability's evidence. Every count below is per
# release, because the ceremony each release asks for is different.
CEREMONY = ("discovery-begin", "discovery-finalize", "knowledge-lookup",
            "knowledge-resolve", "preflight", "init-knowledge-root")

def cli_call_count(ev):
    """How many CaravelaWeb CLI calls one tool event really drove.

    The result is authoritative when it prints protocol objects. A piped or
    truncated result prints fewer, so the loop-aware invocation text is the
    floor: one textual call inside a four-word loop is four calls.
    """
    n_res = len(protocol_objects(ev["result"])) + len(lookup_objects(ev["result"]))
    spans, n_txt = loop_spans(ev["cmd"]), 0
    for m in INVOKE.finditer(ev["cmd"]):
        if m.group(2) not in CEREMONY: continue
        if has_flag(args_at(ev["cmd"], m), "help"): continue
        n_txt += len(reps_at(spans, m.start()))
    return max(n_res, n_txt)

def prefetch_calls(s):
    """CLI calls made before a web fetch closes the pre-fetch window.

    Two windows are reported. The session window ends at the first fetch the
    session ever made. A session that did unrelated work first fetched for
    that work, so the task window ends instead at the first fetch that
    follows the session's first CaravelaWeb CLI call.
    """
    times = [ev["t"] for ev in s["calls"] if ev["t"]]
    first_cli = min(times) if times else None
    cut = s["fetches"][0] if s["fetches"] else None
    task = next((f for f in s["fetches"]
                 if first_cli is not None and f[0] >= first_cli), None)

    def before(edge):
        if edge is None: return sum(cli_call_count(ev) for ev in s["calls"] if ev["t"])
        return sum(cli_call_count(ev) for ev in s["calls"]
                   if ev["t"] and ev["t"] < edge[0])
    return before(cut), cut, before(task), task

def span_calls(s, t0, t1):
    """Tool calls the session made between two moments, ends included."""
    ticks = s["ticks"]
    return bisect.bisect_right(ticks, t1) - bisect.bisect_left(ticks, t0)

def merge(iv):
    """One list of non-overlapping intervals out of overlapping ones."""
    out = []
    for a, b in sorted(iv):
        if out and a <= out[-1][1]: out[-1][1] = max(out[-1][1], b)
        else: out.append([a, b])
    return [(a, b) for a, b in out]

def subtract(A, B):
    """The part of merged intervals A that merged intervals B do not cover."""
    out = []
    for a, b in A:
        cur = [(a, b)]
        for c, d in B:
            nxt = []
            for x, y in cur:
                if d <= x or c >= y: nxt.append((x, y)); continue
                if x < c: nxt.append((x, c))
                if d < y: nxt.append((d, y))
            cur = nxt
        out += cur
    return out

def cover(s, iv):
    """Tool calls and seconds inside a list of non-overlapping intervals."""
    calls = sum(span_calls(s, a, b) for a, b in iv)
    return calls, sum((b - a).total_seconds() for a, b in iv)

def ceremony_calls(r):
    """The CLI calls one run costs: its begin, plus every finalize call."""
    return 1 + len(r["real"]) + len(r["validate"])

def ev_keys(pay):
    out = set()
    for e in (pay.get("evidence") or []):
        if isinstance(e, dict):
            out.add((e.get("locator"), e.get("kind"), e.get("scope")))
    return out

def obs_keys(pay, family):
    return {json.dumps({"value": o.get("value"), "host": o.get("host"),
                        "validation": o.get("validation")},
                       sort_keys=True, default=str)
            for o in obs_of(pay, family)}

def cmp_sets(a, b):
    if a == b: return "identical"
    if a & b: return "overlapping"
    return "disjoint"

def change6(op, rs):
    """op: every run opened in scope. rs: the finalized runs of the same scope."""
    paths = sorted({r["session"] for r in op})
    sess = {p: next(x for x in eligible if x["path"] == p) for p in paths}
    look = {p: lookup_detail(sess[p]) for p in paths}
    print()
    print("CHANGE 6 METRICS")

    # (1) lookup calls per task, per capability, per target.
    look_total = sum(len(look[p]) for p in paths)
    by_cap = collections.Counter(e["capability"] or "(no capability)"
                                 for p in paths for e in look[p])
    by_tgt = collections.Counter(e["target"] or "(no target)"
                                 for p in paths for e in look[p])
    named_t = [t for t in by_tgt if t != "(no target)"]
    named_c = [c for c in by_cap if c != "(no capability)"]
    print("  (1) lookup calls: %d total in %d tasks" % (look_total, len(paths)))
    print("      per task %.2f | per capability %.2f (%d named) | per target %.2f (%d named)"
          % (look_total / len(paths),
             (sum(by_cap[c] for c in named_c) / len(named_c)) if named_c else 0.0,
             len(named_c),
             (sum(by_tgt[t] for t in named_t) / len(named_t)) if named_t else 0.0,
             len(named_t)))
    for p in paths:
        c = collections.Counter(e["capability"] or "-" for e in look[p])
        print("      %-42s lookups=%d caps={%s}"
              % (os.path.basename(p), len(look[p]),
                 ", ".join("%s %d" % kv for kv in sorted(c.items()))))
    for t in sorted(named_t):
        print("      target %-46s lookups=%d" % (t, by_tgt[t]))

    # (2) CaravelaWeb CLI calls made before the first web fetch of the task.
    pre, pre_task = [], []
    print("  (2) pre-fetch CLI calls per task")
    print("      session window ends at the session's first fetch; task window")
    print("      ends at the first fetch after the first CaravelaWeb CLI call")
    for p in paths:
        tot, cut, tot_t, cut_t = prefetch_calls(sess[p])
        pre.append(tot); pre_task.append(tot_t)
        print("      %-42s session=%-3d task=%-3d first_fetch=%s"
              % (os.path.basename(p), tot, tot_t,
                 cut[0].isoformat() if cut else "none in log"))
        print("          fetch that closed the task window: %s"
              % (cut_t[1] if cut_t else "none in log"))
    pmed, pmean, pmax = stats(pre) if pre else (0, 0.0, 0)
    tmed, tmean, tmax = stats(pre_task) if pre_task else (0, 0.0, 0)
    print("      session window median/mean/max    : %s / %.2f / %d"
          % (pmed, pmean, pmax))
    print("      task window median/mean/max       : %s / %.2f / %d"
          % (tmed, tmean, tmax))

    # (3) targets carrying two or more capabilities inside one task.
    groups = {}
    for r in sorted(op, key=lambda r: (r["begin_t"] or RELEASE)):
        groups.setdefault((r["session"], r["target"]), []).append(r)
    multi = {}
    for key, grp in groups.items():
        caps, order = {}, []
        for r in grp:
            if r["capability"] not in caps:
                caps[r["capability"]] = []
                order.append(r["capability"])
            caps[r["capability"]].append(r)
        if len(order) >= 2: multi[key] = (order, caps, grp)
    multi_tasks = sorted({k[0] for k in multi})
    print("  (3) targets with 2+ capabilities      : %s"
          % pct(len(multi), len(groups)))
    print("      tasks holding such a target       : %s"
          % pct(len(multi_tasks), len(paths)))
    for (p, tgt), (order, caps, grp) in sorted(multi.items(), key=lambda kv: str(kv[0])):
        print("      %-24s %-18s caps=%s"
              % (tgt, os.path.basename(p)[:18], ", ".join(str(c) for c in order)))

    # (4) the ceremony those extra capabilities repeat.
    extra_begin = extra_final = repeat_look = 0
    first_begin = first_final = 0
    for (p, tgt), (order, caps, grp) in multi.items():
        first = order[0]
        first_begin += len(caps[first])
        first_final += sum(len(r["real"]) + len(r["validate"]) for r in caps[first])
        for cap in order[1:]:
            extra_begin += len(caps[cap])
            extra_final += sum(len(r["real"]) + len(r["validate"]) for r in caps[cap])
        n_look = sum(1 for e in look[p] if e["target"] == tgt)
        repeat_look += max(0, n_look - 1)
    print("  (4) duplicated ceremony on those targets")
    print("      discovery-begin beyond the first cap  : %d (first cap: %d)"
          % (extra_begin, first_begin))
    print("      discovery-finalize beyond the first   : %d (first cap: %d)"
          % (extra_final, first_final))
    print("      lookups repeated for the same target  : %d" % repeat_look)

    # (5) what the second and later capabilities cost in calls and clock.
    # A run still open has no last finalize, so its window is not measurable
    # yet: it is counted apart instead of entering the comparison as zero.
    def cost(r):
        s = sess[r["session"]]
        t0, t1 = r["begin_t"], r["last_t"]
        if not t0 or not t1: return 0, 0.0
        return span_calls(s, t0, t1), (t1 - t0).total_seconds()
    f_calls = f_secs = l_calls = l_secs = 0.0
    f_n = l_n = open_n = 0
    spans = {}      # session -> (first-capability windows, second+ windows)
    for (p, tgt), (order, caps, grp) in multi.items():
        for cap in order:
            for r in caps[cap]:
                if not (r["real"] or r["validate"]):
                    open_n += 1
                    continue
                c, sec = cost(r)
                w = spans.setdefault(p, ([], []))[0 if cap == order[0] else 1]
                if r["begin_t"] and r["last_t"]: w.append((r["begin_t"], r["last_t"]))
                if cap == order[0]: f_calls += c; f_secs += sec; f_n += 1
                else: l_calls += c; l_secs += sec; l_n += 1
    # A batch run opens every capability in one loop and finalizes them in the
    # next, so the windows of the first and the later capabilities overlap and
    # the per-run figures repeat the same tool calls. The marginal cost is the
    # part of the later windows that the first capability's windows never
    # cover, so it is reported beside them.
    m_calls = m_secs = 0.0
    for p, (fw, lw) in spans.items():
        m = subtract(merge(lw), merge(fw))
        c, sec = cover(sess[p], m)
        m_calls += c; m_secs += sec
    print("  (5) cost of the second and later capabilities")
    print("      runs still open (no finalize yet, excluded) : %d" % open_n)
    print("      first capability   : %d runs, %d tool calls, %.0f s (mean %.1f calls, %.0f s)"
          % (f_n, f_calls, f_secs, (f_calls / f_n) if f_n else 0.0,
             (f_secs / f_n) if f_n else 0.0))
    print("      second+ capability : %d runs, %d tool calls, %.0f s (mean %.1f calls, %.0f s)"
          % (l_n, l_calls, l_secs, (l_calls / l_n) if l_n else 0.0,
             (l_secs / l_n) if l_n else 0.0))
    print("      marginal window    : %d tool calls, %.0f s outside the first"
          " capability's windows" % (m_calls, m_secs))

    # (6) whether the payloads really repeated the shared evidence.
    fams = ["evidence", "transport", "validation"]
    verdicts = {f: collections.Counter() for f in fams}
    dup_items = {f: [0, 0] for f in fams}     # repeated, total on second+
    pairs = 0
    for (p, tgt), (order, caps, grp) in multi.items():
        base = next((r["payload"] for r in caps[order[0]] if r["payload"]), None)
        if base is None: continue
        for cap in order[1:]:
            pay = next((r["payload"] for r in caps[cap] if r["payload"]), None)
            if pay is None: continue
            pairs += 1
            for f in fams:
                a = ev_keys(base) if f == "evidence" else obs_keys(base, f)
                b = ev_keys(pay) if f == "evidence" else obs_keys(pay, f)
                verdicts[f][cmp_sets(a, b)] += 1
                dup_items[f][0] += len(a & b)
                dup_items[f][1] += len(b)
    print("  (6) shared evidence across capabilities on one target (%d comparable pairs)"
          % pairs)
    for f in fams:
        v = verdicts[f]
        print("      %-10s identical %d, overlapping %d, disjoint %d | repeated items %s"
              % (f, v["identical"], v["overlapping"], v["disjoint"],
                 pct(dup_items[f][0], dup_items[f][1])))

    # ---- the residual the maintainer decides from -----------------------
    total_cer = sum(ceremony_calls(r) for r in op) + look_total
    second_cer = extra_begin + extra_final + repeat_look
    dup_all = sum(dup_items[f][0] for f in fams)
    tot_all = sum(dup_items[f][1] for f in fams)
    if len(multi) < 5:
        print("  CHANGE 6 INSUFFICIENT DATA : %d multi-capability targets, need >= 5"
              % len(multi))
    else:
        print("  CHANGE 6 residual : second+ capabilities take %s of ceremony calls; "
              "%s of their evidence repeats the first capability's"
              % (pct(second_cer, total_cer), pct(dup_all, tot_all)))
    return {"multi": len(multi), "second_cer": second_cer, "total_cer": total_cer}

