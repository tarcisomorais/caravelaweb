*:Zone.Identifier

# Test/interpreter caches
__pycache__/
*.py[cod]
.pytest_cache/

# Installation-owned Caravela Operational Memory state (never repository artifacts)
.caravelaweb-knowledge-root
.caravelaweb/*.db
.caravelaweb/*.db-wal
.caravelaweb/*.db-shm
.caravelaweb/*.db-journal
.caravelaweb/*.db-*
.caravelaweb/*.json
.caravelaweb/*.lock
.caravelaweb/knowledge-write-freeze
.caravelaweb/read-authority-operational-memory

# The Knowledge Root corpus directory, created by init-knowledge-root when a
# checkout is also used as a Knowledge Root. Anchored to this repository's root:
# the corpus is installation-owned state, never a repository artifact. A Knowledge
# Root kept anywhere else on disk is unaffected by this rule.
/targets/

.claude/
