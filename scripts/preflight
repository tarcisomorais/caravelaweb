#!/usr/bin/env python3
"""Read-only CaravelaWeb environment report."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

SKILL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SKILL_ROOT))

from discovery_runs import list_open_discoveries
from platform_adapter import configure_utf8_stdio
from readiness import core_readiness
from transport_policy import AVAILABLE, PLATFORM_UNSUPPORTED, UNAVAILABLE

configure_utf8_stdio()


def _command(names: tuple[str, ...]) -> str | None:
    return next((path for name in names if (path := shutil.which(name))), None)


def _agent_browser() -> dict[str, object]:
    agent_browser = shutil.which("agent-browser")
    version = None
    state = "MISSING"
    if agent_browser:
        try:
            result = subprocess.run(
                [agent_browser, "--version"],
                text=True,
                capture_output=True,
                timeout=5,
            )
            output = (result.stdout or result.stderr or "").strip()
            if result.returncode == 0 and output:
                version = output
                state = "AVAILABLE"
            else:
                state = "BROKEN"
        except (OSError, subprocess.SubprocessError):
            state = "BROKEN"
    return {
        # Keep the existing availability spelling for consumers that already
        # inspect this field; state distinguishes a missing executable from a
        # failed lightweight probe.
        "status": AVAILABLE if state == "AVAILABLE" else UNAVAILABLE,
        "state": state,
        "path": agent_browser,
        "version": version,
    }


def _chrome_engine(*, platform_name: str) -> dict[str, object]:
    path = _command(
        ("google-chrome", "google-chrome-stable", "chromium", "chromium-browser", "chrome", "chrome.exe")
    )
    if path is None and platform_name == "win32":
        program_files = (
            os.environ.get("ProgramFiles"),
            os.environ.get("ProgramW6432"),
            os.environ.get("ProgramFiles(x86)"),
        )
        candidates = [
            Path(base) / "Google" / "Chrome" / "Application" / "chrome.exe"
            for base in program_files
            if base
        ]
        if local_app_data := os.environ.get("LOCALAPPDATA"):
            candidates.append(
                Path(local_app_data) / "Google" / "Chrome" / "Application" / "chrome.exe"
            )
        path = next((str(candidate) for candidate in candidates if candidate.is_file()), None)
    return {"state": "DETECTED" if path else "NOT_DETECTED", "path": path}


def _browser_diagnostics(*, platform_name: str | None = None) -> dict[str, object]:
    platform_name = platform_name or sys.platform
    agent_browser = _agent_browser()
    lightpanda = _command(("lightpanda",))
    chrome = _chrome_engine(platform_name=platform_name)
    agent_state = str(agent_browser["state"])
    chrome_ready = agent_state == "AVAILABLE" and chrome["state"] == "DETECTED"
    chrome_reason = (
        None
        if chrome_ready
        else "BROWSER_CONTROL_MISSING"
        if agent_state == "MISSING"
        else "BROWSER_CONTROL_BROKEN"
        if agent_state == "BROKEN"
        else "BROWSER_ENGINE_NOT_DETECTED"
    )
    chrome_transport: dict[str, object] = {
        "status": AVAILABLE if chrome_ready else UNAVAILABLE,
        "path": chrome["path"],
    }
    if chrome_reason:
        chrome_transport["reason"] = chrome_reason
    return {
        "browser_control": {"agent_browser": agent_state},
        "browser_engine": chrome,
        "browser_coverage": {
            "status": "COMPLETE" if chrome_ready else "INCOMPLETE",
            "reason": chrome_reason,
            # A launch proves more than a read-only prerequisite report may.
            "launch_runtime": "NOT_CHECKED",
        },
        "transports": {
            "DIRECT_READ": {"status": AVAILABLE},
            "LIGHTPANDA": {
                "status": (
                    PLATFORM_UNSUPPORTED
                    if platform_name == "win32"
                    else AVAILABLE if agent_state == "AVAILABLE" and lightpanda else UNAVAILABLE
                ),
                "path": lightpanda,
            },
            "CHROME": chrome_transport,
            "agent-browser": agent_browser,
        },
    }


def _transports(*, platform_name: str | None = None) -> dict[str, object]:
    """Backward-compatible transport-only view for internal callers."""
    return _browser_diagnostics(platform_name=platform_name)["transports"]


def build_report(override: str | None) -> dict[str, object]:
    root, core = core_readiness(override)
    browser = _browser_diagnostics()
    report = {
        **core,
        "invocation": {
            "preflight": f'"{sys.executable}" "{Path(__file__).resolve()}"',
            "init_knowledge_root": f'"{sys.executable}" "{SKILL_ROOT / "scripts" / "init-knowledge-root"}"',
            "knowledge_lookup": f'"{sys.executable}" "{SKILL_ROOT / "scripts" / "knowledge-lookup"}"',
            "discovery_begin": f'"{sys.executable}" "{SKILL_ROOT / "scripts" / "discovery-begin"}"',
            "discovery_finalize": f'"{sys.executable}" "{SKILL_ROOT / "scripts" / "discovery-finalize"}"',
            "knowledge_resolve": f'"{sys.executable}" "{SKILL_ROOT / "scripts" / "knowledge-resolve"}"',
        },
        "open_discovery": list_open_discoveries(root) if root else [],
        "transports": browser["transports"],
        "browser_control": browser["browser_control"],
        "browser_engine": browser["browser_engine"],
        "browser_coverage": browser["browser_coverage"],
        "unsupported_optional_components": {
            "advisory_locking": (
                "AVAILABLE"
                if core["platform"]["fcntl"]
                else "PLATFORM_UNSUPPORTED: fcntl is absent"
            ),
        },
    }
    return report


def main() -> int:
    parser = argparse.ArgumentParser(description="Report CaravelaWeb runtime readiness")
    parser.add_argument("--knowledge-root")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    report = build_report(args.knowledge_root)
    if args.json:
        print(json.dumps(report, ensure_ascii=False, sort_keys=True))
    else:
        print(f"status: {report['status']}")
        print(f"platform: {report['platform']['sys_platform']} ({report['platform']['os_name']})")
        print(f"python: {report['platform']['python']} ({report['platform']['python_executable']})")
        print(f"invocation: {report['invocation']['preflight']}")
        for name, value in report["invocation"].items():
            if name != "preflight":
                print(f"invocation_{name}: {value}")
        print(f"knowledge_root: {report['knowledge_root']['path']}")
        print(f"filesystem: {report['knowledge_root']['filesystem_class']}")
        print(f"operational_memory: {'READY' if report['operational_memory'].get('ready') else 'NOT_READY'}")
        print(f"open_discovery: {len(report['open_discovery'])}")
        print(
            "transports: "
            + ", ".join(
                f"{name}={value['status']}"
                for name, value in report["transports"].items()
            )
        )
        print(
            "browser_coverage: "
            f"{report['browser_coverage']['status']} "
            f"(launch_runtime={report['browser_coverage']['launch_runtime']})"
        )
        if reason := report["browser_coverage"].get("reason"):
            print(f"browser_coverage_reason: {reason}")
        print(
            "unsupported_optional_components: "
            + "; ".join(
                f"{name}={value}"
                for name, value in report["unsupported_optional_components"].items()
            )
        )
        for warning in report["warnings"]:
            print(f"warning: {warning}")
        for error in report["errors"]:
            print(f"error: {error}")
    return 0 if report["status"] == "READY" else 2


if __name__ == "__main__":
    raise SystemExit(main())
