#!/usr/bin/env python3
"""Capture the reusable delta from a completed Discovery run."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

SKILL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SKILL_ROOT))

from discovery_finalize import (
    DiscoveryFinalizationError, _resolve_target_argument, finalize_discovery,
)
from discovery_runs import DiscoveryRunError, close_discovery, require_open_discovery
from om_native_writes import WRITE_DESTINATION
from operational_memory import SQLiteOperationalMemory
from platform_adapter import configure_utf8_stdio, resolve_knowledge_root

configure_utf8_stdio()


def read_input(path: str) -> dict:
    raw = sys.stdin.read() if path == "-" else Path(path).read_text(encoding="utf-8")
    value = json.loads(raw)
    if not isinstance(value, dict):
        raise DiscoveryFinalizationError("Discovery input must be a JSON object")
    allowed = {
        "target", "capability", "observations", "evidence", "provenance",
        "recorded_at", "transport_trace",
    }
    unknown = set(value) - allowed
    if unknown:
        raise DiscoveryFinalizationError(
            f"Discovery input contains unsupported fields: {', '.join(sorted(unknown))}"
        )
    return value


def resolve_root(override: str | None) -> Path | None:
    return resolve_knowledge_root(override, start=__file__)


def main() -> int:
    parser = argparse.ArgumentParser(description="Save reusable Discovery knowledge in local Operational Memory")
    parser.add_argument("--input", default="-", help="JSON file, or - for stdin")
    parser.add_argument("--knowledge-root")
    parser.add_argument("--operational-memory-db", help="diagnostic DB override for tests; not part of the supported interface")
    args = parser.parse_args()
    try:
        payload = read_input(args.input)
        root = resolve_root(args.knowledge_root)
        if root is None:
            raise OSError("no usable CaravelaWeb knowledge root could be resolved")
        provenance = payload.get("provenance")
        run_id = provenance.get("run_id") if isinstance(provenance, dict) else None
        db = Path(args.operational_memory_db) if args.operational_memory_db else root / ".caravelaweb" / "operational_memory.db"
        with SQLiteOperationalMemory(db, create=False, knowledge_root=root) as memory:
            target = _resolve_target_argument(memory, payload.get("target"))
            require_open_discovery(
                root, target, payload.get("capability"), run_id
            )
            result = finalize_discovery(
                memory,
                target=target, capability=payload.get("capability"),
                observations=payload.get("observations"), evidence=payload.get("evidence"),
                provenance=payload.get("provenance"), recorded_at=payload.get("recorded_at"),
                transport_trace=payload.get("transport_trace"),
                knowledge_write_authority=True,
                write_destination=WRITE_DESTINATION,
            )
        try:
            close_discovery(
                root, result.target, result.capability, str(run_id)
            )
        except DiscoveryRunError as exc:
            print(json.dumps({
                "status": "FINALIZATION_INCOMPLETE",
                "knowledge_status": result.status,
                "reason": str(exc),
            }, ensure_ascii=False, sort_keys=True), file=sys.stderr)
            return 2
    except (DiscoveryFinalizationError, DiscoveryRunError) as exc:
        # Payload validation refusals already carry a specific, non-internal
        # reason. Surface it so the caller can fix the payload without
        # re-running Discovery. Authority/database/infrastructure failures
        # fall through to the generic branch below.
        print(json.dumps({
            "status": "NOT_SAVED",
            "reason": str(exc),
        }, ensure_ascii=False, sort_keys=True), file=sys.stderr)
        return 2
    except Exception:
        # Unexpected or infrastructure failures: no traceback, no internals,
        # in the normal user flow.
        print(json.dumps({
            "status": "NOT_SAVED",
            "reason": "Discovery could not be finalized in local Operational Memory.",
        }, ensure_ascii=False, sort_keys=True), file=sys.stderr)
        return 2
    print(json.dumps(result.as_dict(), ensure_ascii=False, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
