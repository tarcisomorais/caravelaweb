#!/usr/bin/env python3
"""Initialize a new CaravelaWeb Knowledge Root (NONE -> OPERATIONAL_MEMORY)."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

SKILL_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(SKILL_ROOT))

from installation_init import InitializationRefusedError, initialize_knowledge_root
from platform_adapter import KNOWLEDGE_ROOT_ENV, configure_utf8_stdio

configure_utf8_stdio()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Initialize a new, empty CaravelaWeb Knowledge Root with honest fresh-install provenance"
    )
    parser.add_argument(
        "--knowledge-root",
        help="where to create it; defaults to a recommended per-user location if omitted",
    )
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    try:
        result = initialize_knowledge_root(args.knowledge_root)
    except InitializationRefusedError as error:
        if args.json:
            print(json.dumps({"status": "REFUSED", "reason": str(error)}, ensure_ascii=False, sort_keys=True))
        else:
            print(f"status: REFUSED\nerror: {error}")
        return 2
    if result.remembered:
        if args.json:
            print(json.dumps(
                {"status": "INITIALIZED", "knowledge_root": str(result.root), "remembered": True},
                ensure_ascii=False, sort_keys=True,
            ))
        else:
            print(f"status: INITIALIZED\nknowledge_root: {result.root}")
            print("This is now the default; future commands find it automatically, no --knowledge-root needed.")
            print(f"To use a different root temporarily instead: export {KNOWLEDGE_ROOT_ENV}=<other-root>")
        return 0
    # The Knowledge Root itself is fully valid and usable; only the
    # convenience pointer that lets future commands find it automatically
    # could not be written. Say so plainly and give a way to keep working.
    warning = (
        "initialization succeeded, but the default could not be remembered "
        f"for future sessions: {result.remember_error}"
    )
    if args.json:
        print(json.dumps(
            {
                "status": "INITIALIZED",
                "knowledge_root": str(result.root),
                "remembered": False,
                "warning": warning,
                "next_steps": [
                    f"pass --knowledge-root {result.root} explicitly on future commands",
                    f"or: export {KNOWLEDGE_ROOT_ENV}={result.root}",
                ],
            },
            ensure_ascii=False, sort_keys=True,
        ))
    else:
        print(f"status: INITIALIZED\nknowledge_root: {result.root}")
        print(f"warning: {warning}")
        print(f"Use it with --knowledge-root {result.root}, or: export {KNOWLEDGE_ROOT_ENV}={result.root}")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
